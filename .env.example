# ---- LLM 配置（OpenAI 兼容接口）----
# 可填 OpenAI / DeepSeek / 通义 / Moonshot / 本地 Ollama / 任何兼容端点
AICODER_API_KEY=sk-xxxxxxxxxxxxxxxx
AICODER_BASE_URL=https://api.openai.com/v1
AICODER_MODEL=gpt-4o-mini

# 常见替代配置（取消注释使用其一）：
# DeepSeek:  AICODER_BASE_URL=https://api.deepseek.com/v1   AICODER_MODEL=deepseek-chat
# Ollama:    AICODER_BASE_URL=http://localhost:11434/v1    AICODER_API_KEY=ollama   AICODER_MODEL=qwen2.5-coder
# Moonshot:  AICODER_BASE_URL=https://api.moonshot.cn/v1   AICODER_MODEL=moonshot-v1-8k
# 通义:      AICODER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   AICODER_MODEL=qwen-plus

# ---- 运行行为 ----
AICODER_TEMPERATURE=0.2
AICODER_MAX_TOKENS=4096
# 每次对话最多工具调用轮数
AICODER_MAX_STEPS=25
# 工具执行工作目录（默认当前目录）
# AICODER_WORKDIR=

# ---- 网页服务 ----
AICODER_PORT=8787
# 访问网页端的令牌（留空表示不校验）
AICODER_TOKEN=

# 自动批准所有需要确认的工具（危险，建议保持 false）
AICODER_AUTO_APPROVE=false

# ---- 权限规则 ----
# 格式： allow:工具名 / ask:工具名 / deny:工具名(参数正则)
# 工具名支持 * 通配；括号内为可选参数匹配（对命令/路径等）。
# 优先级： deny > ask > allow。多条用换行或分号分隔。
# 未命中规则时：只读工具放行，写操作询问。
AICODER_PERMISSIONS="deny:run_command(rm -rf|format |del /f);allow:read_file;allow:search"

# ---- 上下文管理 ----
# 上下文窗口预算（token），超出则自动裁剪较早历史
AICODER_MAX_CONTEXT_TOKENS=32768
# 为模型输出预留的 token
AICODER_RESERVE_TOKENS=4096
# 无论如何都保留的最近消息条数
AICODER_KEEP_RECENT=8
# 单个工具结果超过该字符数会被首尾摘要
AICODER_TOOL_RESULT_MAX_CHARS=4000

# ---- MCP / LSP ----
# MCP 服务器与 LSP 服务器建议在项目根目录的 .aicoder.json 中配置，见 README。
# 示例：
# {
#   "mcpServers": { "filesystem": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "."] } },
#   "lspServers": { "typescript": { "command": "typescript-language-server", "args": ["--stdio"] } }
# }

# ---- 向量检索（可选）----
# 启用后 RAG 使用 BM25 + 向量混合检索（需要兼容 /embeddings 的接口）
AICODER_EMBEDDINGS=false
AICODER_EMBEDDING_MODEL=text-embedding-3-small
# 向量权重 0..1，其余给 BM25
AICODER_EMBEDDING_WEIGHT=0.5

# ---- 会话与 UI ----
# 会话存储根目录（默认平台配置目录）
# AICODER_HOME=
# 主题: dark | light | plain
# AICODER_THEME=dark

# ---- 插件 ----
# 逗号或分号分隔的插件列表（本地路径或 npm 包名）
# AICODER_PLUGINS=./plugins/my-plugin.mjs

# ---- 安全 ----
# 是否扫描并阻止疑似密钥写入
AICODER_SECRET_SCAN=true
# 审计日志文件（相对工作目录或绝对路径）
# AICODER_AUDIT_LOG=.aicoder-audit.log

# ---- 可观测性 ----
# 是否统计 token / 费用
AICODER_USAGE=true
# trace 日志文件（append JSONL）
# AICODER_TRACE_FILE=.aicoder-trace.log
# 设置 AICODER_TRACE=1 将 trace 打印到 stderr

# ---- 重试与稳定性 ----
AICODER_MAX_RETRIES=3
AICODER_RETRY_DELAY_MS=500
# 单个工具执行超时（毫秒）
AICODER_TOOL_TIMEOUT_MS=120000

# ---- 语言 ----
# zh | en
# AICODER_LANG=zh

# ---- GitHub 集成（可选）----
# 也可在 .aicoder.json 的 github 字段配置
# AICODER_GITHUB_OWNER=191765
# AICODER_GITHUB_REPO=aicoder
# GITHUB_TOKEN=ghp_xxx

# ---- 并发 ----
# 只读工具并发上限
AICODER_CONCURRENCY=4

# ---- 项目摘要 ----
# 启动时生成仓库摘要并注入上下文（缓存 24h）
AICODER_SUMMARY=true


