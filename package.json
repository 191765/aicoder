{
  "name": "@191765/aicoder",
  "version": "0.1.0",
  "description": "开源 AI 编程助手：终端 (CLI) 与网页 (Web) 双形态，支持任意 OpenAI 兼容 LLM",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "aicoder": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "web",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "dev:web": "tsx src/cli.ts web",
    "start": "node dist/cli.js",
    "start:web": "node dist/cli.js web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "test": "tsx test/unit.ts && tsx test/stage3.ts && tsx test/rag-vector.ts && tsx test/agent-stage3.ts && tsx test/tui-smoke.ts && tsx test/stage4.ts && tsx test/stage4-e2e.ts && tsx test/stage5.ts && tsx test/stage5-retry.ts && tsx test/stage6-concurrency.ts && tsx test/stage6-users.ts && tsx test/stage7.ts && tsx test/stage7-ws.ts && tsx test/stage8.ts && tsx test/stage9.ts && tsx test/stage10.ts && tsx test/stress.ts && tsx test/integration.ts && tsx test/e2e-cli.ts",
    "coverage": "c8 --reporter=text --reporter=html --reporter=lcov npm test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/release.mjs --publish",
    "schema": "node scripts/gen-schema.mjs",
    "sbom": "node scripts/sbom.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "agent",
    "cli",
    "llm",
    "openai",
    "rag"
  ],
  "dependencies": {
    "dotenv": "^16.4.5",
    "openai": "^4.67.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "c8": "^12.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0"
  }
}
