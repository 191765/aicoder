{
  "name": "aicoder",
  "version": "0.1.0",
  "description": "开源 AI 编程助手：终端 (CLI) 与网页 (Web) 双形态，支持任意 OpenAI 兼容 LLM",
  "type": "module",
  "license": "MIT",
  "bin": {
    "aicoder": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "web",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "dev:web": "tsx src/cli.ts web",
    "start": "node dist/cli.js",
    "start:web": "node dist/cli.js web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "agent",
    "cli",
    "llm",
    "openai",
    "rag"
  ],
  "dependencies": {
    "dotenv": "^16.4.5",
    "ignore": "^5.3.1",
    "openai": "^4.67.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
